<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only (launch plan 7.1): plain HTTP to this device and to the
     emulator's host, for a local API and the device tests' local pages, as
     iOS allows local networking in development. Release builds keep
     Android's default: HTTPS only. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
