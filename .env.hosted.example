# Copy to ignored .env.hosted; never pass this file to Flutter.
ENVIRONMENT=development
API_PORT=8080
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Obtain from Supabase Connect, with the real password. Never use the local DB here.
DATABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
API_CURSOR_SIGNING_KEY=
RATE_LIMIT_HMAC_SIGNING_KEY=
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=
# Stored for future Stripe integration; current subscriptions use native stores.
# no reader: no Stripe integration exists; subscriptions use native store billing
# STRIPE_SECRET_KEY=
# no reader: as above
# STRIPE_PUBLISHABLE_KEY=
# no reader: Azure provider config lives in the Supabase dashboard
# AZURE_CLIENT_ID=
# no reader: reference value for the tunnel runbook only
# CLOUDFLARE_TUNNEL_ID=
PAY071_BILLING_ENABLED=false
# AWS CloudWatch Logs. Both must be set or the API logs only to stdout.
# The log group must already exist; the API creates only its own stream.
# Credentials are NOT set here when the host has an IAM role (ECS/EC2/App
# Runner) - the SDK resolves them itself. Outside AWS there is no role, so a
# CloudWatch-write-only IAM user's keys are required instead; add them to the
# deployed host's secret store, never to this file or to Flutter.
AWS_REGION=il-central-1
AWS_LOG_GROUP=/studafy/application
# Study assistant (student AI helper). All three must be set or the tab is
# absent. AI_BASE_URL is an allowlist of exactly one origin: the previous AI
# integration sent to whatever a URL variable named, which is how it became
# the SEC-001 critical vulnerability (ADR-0026).
AI_API_KEY=
AI_BASE_URL=https://api.together.xyz
AI_MODEL=Qwen/Qwen3.5-9B
AI_DAILY_QUESTION_LIMIT=30
