{
  "name": "studafy",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "format": "deno fmt apps packages scripts ops package.json tsconfig.base.json docker-compose.dev.yml .github/workflows/ci.yml .github/workflows/release-artifacts.yml .github/workflows/backup.yml",
    "format:check": "deno fmt --check apps packages scripts ops package.json tsconfig.base.json docker-compose.dev.yml .github/workflows/ci.yml .github/workflows/release-artifacts.yml .github/workflows/backup.yml",
    "lint": "deno lint --rules-exclude=no-sloppy-imports,require-await apps packages scripts ops",
    "generate:dart-client": "bun scripts/generate-dart-client.ts",
    "generate:openapi": "bun scripts/generate-openapi.ts",
    "generate:openapi:check": "bun scripts/generate-openapi.ts --check",
    "generate:check": "bun scripts/generate-openapi.ts --check && bun scripts/generate-dart-client.ts --check",
    "generate:db-types": "bun scripts/generate-db-types.ts",
    "generate:db-types:check": "bun scripts/generate-db-types.ts --check",
    "test:plans:tenancy": "bun scripts/verify-tenancy-query-plans.ts",
    "test:plans:rls": "bun scripts/verify-rls-policy-plans.ts",
    "test:plans:academic": "bun scripts/verify-academic-query-plans.ts",
    "test:plans:coursework": "bun scripts/verify-coursework-query-plans.ts",
    "test:plans:uploads": "bun scripts/verify-upload-query-plans.ts",
    "test:uploads:storage": "bun scripts/verify-upload-storage.ts",
    "test:plans:delivery": "bun scripts/verify-delivery-query-plans.ts",
    "test:delivery:e2e": "bun apps/api/scripts/verify-delivery.ts",
    "test:delivery:reconcile": "bun apps/api/scripts/delivery-reconciliation.ts",
    "test:delivery:malware-drill": "bun apps/api/scripts/delivery-malware-drill.ts",
    "test:plans:outbox": "bun scripts/verify-outbox-query-plans.ts",
    "test:outbox:e2e": "bun test apps/worker/test/outbox.integration.test.ts",
    "ops:outbox-redrive": "bun scripts/redrive-outbox-dlq.ts",
    "alerts:test": "bun apps/worker/src/monitoring/sendTestAlert.ts",
    "scale:prepare": "bash scripts/scale/prepare-scale-db.sh",
    "scale:bench": "bun scripts/scale/bench.ts",
    "scale:http": "bun scripts/scale/http-load.ts",
    "legal:build": "bun ops/legal-site/build.ts",
    "legal:deploy": "bun ops/legal-site/build.ts && npx --yes wrangler@4 deploy --config ops/legal-site/wrangler.toml",
    "test:auth:lifecycle": "bun apps/api/scripts/verify-auth-lifecycle.ts",
    "test": "bun test apps packages",
    "typecheck": "bun run --filter='@studafy/*' typecheck",
    "check:bounds": "bun scripts/check-bounds.ts && bun scripts/check-file-boundaries.ts",
    "build": "bun run --filter='@studafy/api' build && bun run --filter='@studafy/worker' build",
    "dev:stack": "docker compose -f docker-compose.dev.yml up -d || docker-compose -f docker-compose.dev.yml up -d",
    "check:migrations": "bun scripts/check-migration-immutability.ts",
    "dev:hosted": "bun --no-env-file scripts/start-hosted-api.ts",
    "dev:hosted:worker": "bun --no-env-file scripts/start-hosted-worker.ts"
  },
  "dependencies": {},
  "overrides": {
    "jsrsasign": "^11.1.5"
  },
  "devDependencies": {
    "@supabase/supabase-js": "2.116.0",
    "@types/bun": "1.4.2",
    "postgres": "3.4.9",
    "supabase": "2.117.0",
    "typescript": "7.0.2",
    "zod": "4.6.6"
  }
}
