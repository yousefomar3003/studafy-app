# Local synthetic development only. Copy to .env; never commit populated values.
# Deployed values belong in the Supabase project secret manager.
SUPABASE_URL=<local-synthetic-project-url>
SUPABASE_ANON_KEY=<local-synthetic-publishable-key>
SUPABASE_SERVICE_ROLE_KEY=<local-synthetic-secret>

# Used by create-google-meet / cancel-google-meet. Omit locally to get the
# configured 503 path; never deploy real broker secrets outside the Supabase
# project secret manager.
GOOGLE_TOKEN_BROKER_URL=<synthetic-token-broker-url>
GOOGLE_TOKEN_BROKER_SECRET=<local-synthetic-secret>

# PAY-071 retired verify-store-purchase: billing now runs through apps/api's
# /v1/billing/* (official Apple/Google APIs), so no verifier URL/secret exists.

# AI-072 (ADR-0026) removed every AI Edge Function. No AI or Study Coach
# provider variable exists, and none may be added to re-enable one.
