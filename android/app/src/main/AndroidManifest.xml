<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Every screen talks to the Studafy API. Flutter adds this only to the
         debug and profile manifests, so a release build without it could not
         reach the server at all (launch plan 3.2). -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Voice notes in messages. Asked for only when someone first records. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- Push notifications on Android 13 and later. Asked for at sign-in. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- No Android Auto Backup: the offline cache, attachments, AI chat history
         and profile photos must not reach Google Drive backups (launch plan
         3.6, docs/store/google-play-data-safety.md). -->
    <application
        android:label="Studafy"
        android:name="${applicationName}"
        android:localeConfig="@xml/locales_config"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- AUTH-030: the owned HTTPS App Link is the preferred OAuth
                 callback. autoVerify makes Android check
                 https://app.studafy.com/.well-known/assetlinks.json at install
                 time (served by ops/legal-site, src/app-links.ts); until it
                 carries the release signing fingerprint (blocked on Play App
                 Signing), verification fails and Android falls back to the
                 disambiguation dialog rather than opening the app silently. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data
                    android:scheme="https"
                    android:host="app.studafy.com"
                    android:pathPrefix="/auth/callback"/>
            </intent-filter>
            <!-- Fallback only. A custom scheme cannot be claimed exclusively:
                 any app may register it. PKCE is what makes an intercepted
                 code useless, and AuthCallbackGuard refuses inbound links that
                 do not target one of these exact callbacks. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="io.studafy.app" android:host="login-callback"/>
            </intent-filter>
            <!-- JOIN-052: a teacher's class join link,
                 io.studafy.app://join?t=... (lib/core/class_join_link.dart).
                 iOS opens every link on the scheme; Android only the hosts
                 listed, so without this a tapped link never reaches
                 ClassJoinLinkGuard. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="io.studafy.app" android:host="join"/>
            </intent-filter>
        </activity>
        <!-- Opening a downloaded attachment (lib/core/attachment_opener.dart):
             the file is handed to a viewer app through this provider, from
             the cache folder only (xml/attachment_paths.xml). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.attachments"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/attachment_paths" />
        </provider>
        <!-- Push notifications shown by Firebase while the app is in the
             background: Android draws only the small icon's alpha, so the
             full-colour launcher icon would be a white square. The white S,
             tinted with the brand navy. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/brand_navy" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Android 11+ package visibility. url_launcher opens web links
             (lessons, meetings, legal pages, store subscriptions) and OAuth
             sign-in in Custom Tabs; image_picker grants the camera app
             access to the photo it takes. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <category android:name="android.intent.category.BROWSABLE"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService"/>
        </intent>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE"/>
        </intent>
    </queries>
</manifest>
