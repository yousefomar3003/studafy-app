<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 and later always show the system splash screen, which can
         only draw one centred icon (no wordmark): the white S on the brand
         navy. The Flutter screens that follow show the white wordmark on the
         same navy. values-night-v31 matches this for dark mode. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/brand_navy</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
