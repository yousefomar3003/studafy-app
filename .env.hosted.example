# Copy to ignored .env.hosted; never pass this file to Flutter.
ENVIRONMENT=development
API_PORT=8080
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Obtain from Supabase Connect, with the real password. Never use the local DB here.
DATABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
API_CURSOR_SIGNING_KEY=
RATE_LIMIT_HMAC_SIGNING_KEY=
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=
# Stored for future Stripe integration; current subscriptions use native stores.
# no reader: no Stripe integration exists; subscriptions use native store billing
# STRIPE_SECRET_KEY=
# no reader: as above
# STRIPE_PUBLISHABLE_KEY=
# no reader: Azure provider config lives in the Supabase dashboard
# AZURE_CLIENT_ID=
# no reader: reference value for the tunnel runbook only
# CLOUDFLARE_TUNNEL_ID=
# Store subscriptions (Studafy Plus / Max). Every name, what it is and where
# to get it: .env.example and docs/deployment/subscriptions.md. Leave billing
# off until the store credentials below are real.
PAY071_BILLING_ENABLED=false
# PAY071_ENVIRONMENT=development
# APPLE_BUNDLE_ID=
# APPLE_ENVIRONMENT=Sandbox
# APPLE_APP_APPLE_ID=
# APPLE_ISSUER_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=
# APPLE_ROOT_CERTIFICATES_BASE64=
# GOOGLE_PACKAGE_NAME=com.studafy.light
# GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_PUBSUB_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_PUBSUB_AUDIENCE=
# Push and email (worker). The FCM key is the server's; never the app's.
# NOTIFICATION_CHANNELS_ENABLED=false
# FCM_PROJECT_ID=
# FCM_SERVICE_ACCOUNT_JSON=
# RESEND_API_KEY=
# EMAIL_FROM_ADDRESS=
# AWS CloudWatch Logs. Both must be set or the API logs only to stdout.
# The log group must already exist; the API creates only its own stream.
# Credentials are NOT set here when the host has an IAM role (ECS/EC2/App
# Runner) - the SDK resolves them itself. Outside AWS there is no role, so a
# CloudWatch-write-only IAM user's keys are required instead; add them to the
# deployed host's secret store, never to this file or to Flutter.
AWS_REGION=il-central-1
AWS_LOG_GROUP=/studafy/application
# Study assistant (student AI helper). All three must be set or the tab is
# absent. AI_BASE_URL is an allowlist of exactly one origin: the previous AI
# integration sent to whatever a URL variable named, which is how it became
# the SEC-001 critical vulnerability (ADR-0026).
AI_API_KEY=
AI_BASE_URL=https://api.together.xyz
AI_MODEL=Qwen/Qwen3.5-9B
# Daily questions and monthly AI spend per plan live in the database
# (private.ai_plan_limits), not here. Prices must match the provider's list:
# the Plus / Max caps are enforced against them.
AI_PRICE_INPUT_USD_PER_MTOK=0.17
AI_PRICE_OUTPUT_USD_PER_MTOK=0.25
# Whiteboard notes, quizzes and flashcards. Off until the provider DPA and the
# minors' DPIA are in place (ADR-0029).
AI_LESSON_TOOLS_ENABLED=false

# JOIN-053 short class codes (e.g. K7QM-4XTR) - a second way to redeem a class
# join link, for a child typing on a parent's phone or a code on the board.
# Stored as an HMAC under this key, which must never be in the database and
# must differ from API_CURSOR_SIGNING_KEY and RATE_LIMIT_HMAC_SIGNING_KEY.
# Leave empty to issue links only. Generate with: openssl rand -hex 32
# CLASS_JOIN_CODE_KEY=
