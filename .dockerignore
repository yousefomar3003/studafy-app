# Keep secrets and bulk out of the build context.
#
# The .env rules are the important ones: a build context is readable by
# anyone who can pull the image layers, and SEC-001 keeps these files out of
# git for the same reason.
.env
.env.*
!.env.example
!.env.hosted.example
config/dart-defines.*.json
!config/dart-defines.*.example.json

.git
.github
node_modules
**/node_modules

# The Flutter app is not part of the API image.
lib
test
integration_test
ios
android
build
.dart_tool
pubspec.lock

supabase
docs
scripts/seed-reviewer-tenant.ts
**/*.test.ts
**/test/
coverage
*.log
.DS_Store
