.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
**/.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
**/build/
**/coverage/
**/Flutter/ephemeral/

# Local dependencies and tool state
**/node_modules/
**/.gradle/
**/local.properties
.vscode/
.supabase/
supabase/.branches/
supabase/.temp/

# Bun workspace build output
**/dist/

# Local databases and generated scan reports
*.db
*.db-*
*.sqlite
*.sqlite3
*.sarif
.gitleaks-report*

# Runtime configuration and secrets. Sanitized examples remain tracked.
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# Credentials, signing material, and provider-specific configuration
*.pem
*.key
*.p8
*.p12
*.pfx
*.jks
*.keystore
*.mobileprovision
**/key.properties
**/google-services.json
**/GoogleService-Info.plist
**/firebase_options.dart
**/*service-account*.json
**/*credentials*.json
**/*secrets*.json

# Local dart-define files may contain publishable project configuration.
config/dart-defines.*.json
!config/dart-defines.*.example.json

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/
