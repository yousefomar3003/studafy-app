# Bun API/worker local development. Copy to .env, replace every placeholder,
# and keep the resulting file ignored.
ENVIRONMENT=YOUR_LOCAL_ENVIRONMENT
API_PORT=YOUR_LOCAL_API_PORT
DATABASE_URL=YOUR_LOCAL_DATABASE_URL
API_CURSOR_SIGNING_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
API041_CLASSES_ENABLED=true
API041_CONTENT_ENABLED=true
API041_ASSIGNMENTS_ENABLED=true
API041_ASSESSMENTS_ENABLED=true
API041_GRADES_ENABLED=true
API041_ATTENDANCE_ENABLED=true
API041_WELLBEING_ENABLED=true
# SAFE-043 safety/safeguarding slices. The symmetric block gate over
# API-042 conversations is enforced in the database unconditionally once this
# migration is applied, so it needs no flag of its own.
SAFE043_REPORTING_ENABLED=true
SAFE043_BLOCKS_ENABLED=true
SAFE043_MODERATION_ENABLED=true
SAFE043_CONTENT_CONTROLS_ENABLED=true
# FILE-050 stays off unless explicitly enabled in a disposable environment.
FILE050_NEW_INTENTS_ENABLED=false
REDIS_URL=YOUR_LOCAL_REDIS_URL
LOG_LEVEL=YOUR_LOCAL_LOG_LEVEL

# AUTH-030. SUPABASE_URL is the project origin; the API derives the JWT issuer
# and the JWKS endpoint from it, so one value cannot drift from the other.
# Production refuses to start without it: with no key set there is nothing to
# verify a token against.
SUPABASE_URL=YOUR_LOCAL_SUPABASE_URL
# Server/worker only. Never copy this value into Flutter or a dart-define.
# SUPABASE_SERVICE_ROLE_KEY=YOUR_LOCAL_SERVICE_ROLE_KEY
FILE050_CLEANUP_ENABLED=false
AUTH_JWT_AUDIENCE=authenticated
AUTH_CLOCK_SKEW_SECONDS=30
# 0 means a revoked session stops working on its very next request.
AUTH_REVOCATION_BUDGET_SECONDS=0
AUTH_REAUTH_TTL_SECONDS=300
AUTH_DELETION_GRACE_DAYS=14

# OPS-060 rate limiting. The limiter and the revocation-safe session-context
# cache share REDIS_URL above. Keys carry HMAC(subject), never a raw
# identifier, so the key namespace itself is not an enumeration channel.
# Production refuses to start with limiting enabled and no configured key
# (it is per-environment and rotatable per docs/security/ops060-operator-runbook.md);
# development without one mints an ephemeral key for the process lifetime.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_HMAC_SIGNING_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES

# ===========================================================================
# RESERVED — later phases (instructions.md §22.6)
#
# These are the destinations for the remaining runtime secrets, named now so
# each has a known home before its phase begins. They stay COMMENTED OUT
# until the code that reads them exists: an environment variable with no
# reader is a live credential guarding nothing.
#
# Only *runtime* secrets the API or worker read belong here. Deploy and
# signing credentials never do — see the split at the bottom of this file.
# ===========================================================================

# --- Phase 5 (FILE-051): scanning, delivery, publication --------------------
# All three switches default to false: FILE-051 builds the pipeline, it does
# not switch it on. The reviewed flip of allowsRemoteFileUploads is a separate
# change with its own decision-log entry.
FILE051_DELIVERY_ENABLED=false
FILE051_PUBLISH_ENABLED=false
FILE051_SCAN_ENABLED=false
FILE051_RETENTION_ENABLED=false
# Signs single-use delivery URLs. Required when FILE051_DELIVERY_ENABLED=true
# in production; generate with: openssl rand -hex 32
# FILE051_DELIVERY_SIGNING_KEY=
# Absolute base URL used to build delivery links (local default shown).
# FILE051_DELIVERY_PUBLIC_BASE_URL=http://127.0.0.1:8080
# External malware scanner. Local/disposable runs use the deterministic
# structural scanner instead; production refuses to scan without a provider,
# and the key belongs in the CI/platform secret manager, never in a file.
# MALWARE_SCANNER_API_KEY=
# MALWARE_SCANNER_URL=

# --- Phase 6 (OPS-060): managed Redis ---------------------------------------
# Not a separate key: the password is embedded in the connection URL, and
# REDIS_URL above is the only Redis configuration there is. In production it
# becomes rediss:// (TLS) with AUTH, on a private network; the API and the
# worker both refuse a plaintext or passwordless production URL at boot.
#   REDIS_URL=rediss://default:PASSWORD@host.example.com:6380
# Rate-limit and cache keys use dedicated namespaces (studafy:{env}:rl,
# studafy:{env}:cache) and must stay on a non-evicting allocation separate
# from BullMQ's (studafy-{env}) - see the operator runbook.

# --- Phase 6: transactional email -------------------------------------------
# EMAIL_PROVIDER_API_KEY=
# EMAIL_FROM_DOMAIN=

# --- Phase 6/7: push delivery -----------------------------------------------
# FCM and APNs are file-based, not env vars. android/app/google-services.json
# and the APNs .p8 are native build inputs held as CI secrets, never here.

# --- Phase 8 (INFRA-080): production data stores ----------------------------
# The production DATABASE_URL and SUPABASE_SERVICE_ROLE_KEY live in the
# platform secret manager and are injected at runtime. They must never be
# written to a file on a developer machine.

# --- Phase 9 (OPS-090): error tracking --------------------------------------
# Must be PII-scrubbed before it can receive anything from a product handling
# minors' data.
# SENTRY_DSN=

# --- Deferred: AI provider --------------------------------------------------
# BLOCKED twice over, so this slot stays closed even when a key exists:
#   1. allowsAiGrading => false in lib/core/runtime_environment.dart is a
#      SEC-001 containment guard; removing it is a reviewed code change.
#   2. §22.6 marks the key blocked until a data processing agreement is signed.
# Setting it changes nothing: the grading endpoint returns AI_GRADING_DISABLED
# without reading a body or contacting a provider.
# AI_PROVIDER_API_KEY=

# ===========================================================================
# NOT here — different destinations by design (§22.2, §22.4, §22.6)
#
#   CI secrets          Cloudflare API token and zone ID, container-host
#                       deploy token, Android keystore (base64) and its
#                       passwords, Apple distribution certificate and
#                       provisioning profile, App Store Connect API key,
#                       Play service account JSON, Pub/Sub credentials
#   Secret manager      Production DATABASE_URL, service-role key, managed
#                       Redis URL
#   Password manager    Keystore master copy and offline backup
#   Native build input  google-services.json, APNs .p8, Cloudflare origin cert
#
# A deploy credential on a laptop is the thing §22.2 is written to prevent.
# ===========================================================================

# Do not place Supabase service-role keys, provider credentials, signing
# credentials, store secrets, or production connection strings in this file.
