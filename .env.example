# Bun API/worker local development. Copy to .env, replace every placeholder,
# and keep the resulting file ignored.
ENVIRONMENT=YOUR_LOCAL_ENVIRONMENT
API_PORT=YOUR_LOCAL_API_PORT
DATABASE_URL=YOUR_LOCAL_DATABASE_URL
# Connections each API process holds (docs/operations/capacity.md). Every
# request runs two or three short transactions; the old fixed 5 capped one
# instance near 275 requests/s. Keep (API instances x this) + the worker's
# under the database's connection limit for its plan.
DATABASE_POOL_MAX=20
# Worker: removes expired idempotency records every few minutes. On unless
# set to false.
# DB_HOUSEKEEPING_ENABLED=true
API_CURSOR_SIGNING_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
API041_CLASSES_ENABLED=true
API041_CONTENT_ENABLED=true
API041_ASSIGNMENTS_ENABLED=true
API041_ASSESSMENTS_ENABLED=true
API041_GRADES_ENABLED=true
API041_ATTENDANCE_ENABLED=true
API041_WELLBEING_ENABLED=true
# SAFE-043 safety/safeguarding slices. The symmetric block gate over
# API-042 conversations is enforced in the database unconditionally once this
# migration is applied, so it needs no flag of its own.
SAFE043_REPORTING_ENABLED=true
SAFE043_BLOCKS_ENABLED=true
SAFE043_MODERATION_ENABLED=true
SAFE043_CONTENT_CONTROLS_ENABLED=true
# FILE-050 stays off unless explicitly enabled in a disposable environment.
FILE050_NEW_INTENTS_ENABLED=false
REDIS_URL=YOUR_LOCAL_REDIS_URL
LOG_LEVEL=YOUR_LOCAL_LOG_LEVEL

# Server/worker only. Never copy these into Flutter or a dart-define.
# Log shipping to AWS CloudWatch Logs. Both must be set or the API logs only to
# stdout, so local development and CI need neither. Credentials are deliberately
# absent: the AWS SDK resolves them from the task/instance role, and an access
# key in this file would be a credential guarding nothing.
# The log group must already exist; the API creates only its own log stream.
AWS_REGION=il-central-1
AWS_LOG_GROUP=/studafy/application

# AUTH-030. SUPABASE_URL is the project origin; the API derives the JWT issuer
# and the JWKS endpoint from it, so one value cannot drift from the other.
# Production refuses to start without it: with no key set there is nothing to
# verify a token against.
SUPABASE_URL=YOUR_LOCAL_SUPABASE_URL
# Server/worker only. Never copy this value into Flutter or a dart-define.
# SUPABASE_SERVICE_ROLE_KEY=YOUR_LOCAL_SERVICE_ROLE_KEY
FILE050_CLEANUP_ENABLED=false
AUTH_JWT_AUDIENCE=authenticated
AUTH_CLOCK_SKEW_SECONDS=30
# 0 means a revoked session stops working on its very next request.
AUTH_REVOCATION_BUDGET_SECONDS=0
AUTH_REAUTH_TTL_SECONDS=300
AUTH_DELETION_GRACE_DAYS=14

# OPS-060 rate limiting. The limiter and the revocation-safe session-context
# cache share REDIS_URL above. Keys carry HMAC(subject), never a raw
# identifier, so the key namespace itself is not an enumeration channel.
# Production refuses to start with limiting enabled and no configured key
# (it is per-environment and rotatable per docs/security/ops060-operator-runbook.md);
# development without one mints an ephemeral key for the process lifetime.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_HMAC_SIGNING_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES

# ===========================================================================
# RESERVED — later phases (docs/planning/instructions.md §22.6)
#
# These are the destinations for the remaining runtime secrets, named now so
# each has a known home before its phase begins. They stay COMMENTED OUT
# until the code that reads them exists: an environment variable with no
# reader is a live credential guarding nothing.
#
# Only *runtime* secrets the API or worker read belong here. Deploy and
# signing credentials never do — see the split at the bottom of this file.
# ===========================================================================

# --- Phase 5 (FILE-051): scanning, delivery, publication --------------------
# All three switches default to false: FILE-051 builds the pipeline, it does
# not switch it on. The reviewed flip of allowsRemoteFileUploads is a separate
# change with its own decision-log entry.
FILE051_DELIVERY_ENABLED=false
FILE051_PUBLISH_ENABLED=false
FILE051_SCAN_ENABLED=false
FILE051_RETENTION_ENABLED=false
# Signs single-use delivery URLs. Required when FILE051_DELIVERY_ENABLED=true
# in production; generate with: openssl rand -hex 32
# FILE051_DELIVERY_SIGNING_KEY=
# Absolute base URL used to build delivery links (local default shown).
# FILE051_DELIVERY_PUBLIC_BASE_URL=http://127.0.0.1:8080
# External malware scanner. Local/disposable runs use the deterministic
# structural scanner instead; production refuses to scan without a provider,
# and the key belongs in the CI/platform secret manager, never in a file.
# MALWARE_SCANNER_API_KEY=
# MALWARE_SCANNER_URL=

# --- Phase 6 (OPS-061): BullMQ outbox drain ----------------------------------
# The worker's transactional-outbox drain (audience rows -> BullMQ ->
# deliveries). Off by default; enabling it requires DATABASE_URL because the
# durable outbox row is the idempotency fence, not Redis. See
# docs/security/ops061-operator-runbook.md.
OPS061_NOTIFICATIONS_ENABLED=false
# OPS061_OUTBOX_POLL_INTERVAL_MS=5000
# OPS061_OUTBOX_CONCURRENCY=5
# The queue allocation must be non-evicting and persisted; production fails
# closed otherwise. docker-compose.dev.yml pins the flags locally.

# --- Phase 6 (OPS-060): managed Redis ---------------------------------------
# Not a separate key: the password is embedded in the connection URL, and
# REDIS_URL above is the only Redis configuration there is. In production it
# becomes rediss:// (TLS) with AUTH, on a private network; the API and the
# worker both refuse a plaintext or passwordless production URL at boot.
#   REDIS_URL=rediss://default:PASSWORD@host.example.com:6380
# Rate-limit and cache keys use dedicated namespaces (studafy:{env}:rl,
# studafy:{env}:cache) and must stay on a non-evicting allocation separate
# from BullMQ's (studafy-{env}) - see the operator runbook.

# --- Push delivery: app side ------------------------------------------------
# Not server variables. The app needs PUSH_ENABLED=true plus either the
# FIREBASE_* dart-defines or the native Firebase files, and the APNs key must
# be uploaded to the Firebase console. See docs/deployment/push-notifications.md.

# --- DL-051: account rights executors (worker) --------------------------------
# Execute account deletions after their grace period, and build requested
# data exports. Both use DATABASE_URL; the request rows are the work queue.
ACCOUNT_DELETION_EXECUTOR_ENABLED=false
DATA_EXPORT_EXECUTOR_ENABLED=false
# ACCOUNT_RIGHTS_POLL_INTERVAL_MS=60000

# --- DL-052: meeting processor (worker) -------------------------------------
# Creates Google Calendar events with Meet links as a Workspace user through
# domain-wide delegation. Attendee emails leave Studafy only when this is on,
# so enable it only once the Workspace processing terms are in place.
MEETINGS_PROCESSOR_ENABLED=false
# GOOGLE_CALENDAR_SERVICE_ACCOUNT_JSON=
# GOOGLE_CALENDAR_ORGANIZER_EMAIL=

# --- DL-053: email and push delivery (worker) --------------------------------
# Each channel runs only when its provider is configured. Only fixed,
# content-free copy is sent. Provider endpoints are fixed in code.
# Subscription notices (active / renewed / payment problem / ended) use this
# path; the stores send the actual receipts (docs/deployment/subscriptions.md).
NOTIFICATION_CHANNELS_ENABLED=false
# Resend -> API Keys -> "Sending access" key for the verified domain.
# RESEND_API_KEY=re_REPLACE_WITH_RESEND_KEY
# Must be on a domain verified in Resend (SPF/DKIM records added).
# EMAIL_FROM_ADDRESS=Studafy <no-reply@your-verified-domain.example>
# Firebase console -> Project settings -> General -> Project ID.
# FCM_PROJECT_ID=studafy-example
# Firebase console -> Project settings -> Service accounts -> Generate new
# private key. Paste the JSON on one line. Worker only: this private key must
# never be in the app, a dart-define, or the repository.
# FCM_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"studafy-example","private_key":"REPLACE","client_email":"firebase-adminsdk@studafy-example.iam.gserviceaccount.com"}

# --- Phase 7 (PAY-071): store billing ----------------------------------------
# The billing module (apps/api /v1/billing/*, apps/worker drain, ledger tables
# from DB-020). Off by default like every module switch; the paid products stay
# gated at the catalogue layer (storefront_listed), not here. See
# docs/evidence/pay-071/README.md before enabling, and note
# PAY071_ENVIRONMENT must match the client's billing environment so a sandbox
# receipt can never be accepted as a production purchase (§21.8).
#
# API and worker both read these. Every value below is a dummy; where each
# real one comes from is in docs/deployment/subscriptions.md. Store product
# ids are not variables: they are rows in public.store_products
# (studafy_plus_monthly, studafy_max_monthly) created by migration.
PAY071_BILLING_ENABLED=false
# development for sandbox testing; production only with real store products.
# PAY071_ENVIRONMENT=development
#
# Apple (App Store Connect):
#   The app's bundle identifier (Xcode -> Runner -> Signing).
# APPLE_BUNDLE_ID=com.example.studafy
#   Sandbox for TestFlight/sandbox testers, Production for the live app.
# APPLE_ENVIRONMENT=Sandbox
#   App Store Connect -> App Information -> Apple ID (a number).
# APPLE_APP_APPLE_ID=1234567890
#   Users and Access -> Integrations -> In-App Purchase -> Issuer ID.
# APPLE_ISSUER_ID=00000000-0000-0000-0000-000000000000
#   The same page: generate an In-App Purchase key; its Key ID ...
# APPLE_KEY_ID=ABCDEFGHIJ
#   ... and the downloaded .p8 contents. In a .env file keep the double
#   quotes, which turn each \n into a newline; a secret manager takes the
#   file's text as is.
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE\n-----END PRIVATE KEY-----"
#   Apple Root CA - G3 (and G2) from https://www.apple.com/certificateauthority/,
#   each DER file base64-encoded, comma-separated.
# APPLE_ROOT_CERTIFICATES_BASE64=REPLACE_BASE64_DER_G3,REPLACE_BASE64_DER_G2
#
# Google (Play Console and Google Cloud):
#   The Android applicationId (android/app/build.gradle.kts).
# GOOGLE_PACKAGE_NAME=com.studafy.light
#   A Cloud service account invited in Play Console -> Users and permissions
#   with "View financial data" and "Manage orders and subscriptions". Its key
#   JSON on one line.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"studafy-example","private_key":"REPLACE","client_email":"play-billing@studafy-example.iam.gserviceaccount.com"}
#   The service account Pub/Sub signs its push requests as (the push
#   subscription's "Enable authentication" account) ...
# GOOGLE_PUBSUB_SERVICE_ACCOUNT_EMAIL=pubsub-push@studafy-example.iam.gserviceaccount.com
#   ... and the push endpoint's exact URL, which is the token's audience.
# GOOGLE_PUBSUB_AUDIENCE=https://api.example.com/webhooks/google
#
# Worker-only: re-verify open and lapsed transactions with the store (lost
# webhooks, renewals, Google's 3-day acknowledgement window).
# PAY071_RECONCILIATION_ENABLED=true
# PAY071_OUTBOX_POLL_INTERVAL_MS=5000
# PAY071_OUTBOX_CONCURRENCY=5

# --- Backups ------------------------------------------------------------------
# Not in this file. The backup workflow's settings live in the GitHub
# environment "backups" (docs/deployment/backups.md):
#   secrets    BACKUP_DATABASE_URL, SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY
#   variables  BACKUP_AGE_RECIPIENTS, BACKUP_INCLUDE_STORAGE,
#              BACKUP_RETENTION_DAYS, BACKUP_S3_BUCKET, BACKUP_AWS_ROLE_ARN,
#              BACKUP_AWS_REGION
# The age PRIVATE key that decrypts backups is kept offline (password
# manager), never in GitHub, this file or any server.

# --- Phase 8 (INFRA-080): production data stores ----------------------------
# The production DATABASE_URL and SUPABASE_SERVICE_ROLE_KEY live in the
# platform secret manager and are injected at runtime. They must never be
# written to a file on a developer machine.

# --- Phase 9 (OPS-090): error tracking --------------------------------------
# Must be PII-scrubbed before it can receive anything from a product handling
# minors' data.
# SENTRY_DSN=

# --- AI provider: removed ---------------------------------------------------
# AI-072 (ADR-0026, DL-047) removed the AI capability: no signed DPA and no
# DPIA covering AI processing of minors' data exist. There is no AI or Study
# Coach variable, and adding one re-enables nothing - a future AI capability
# needs a new ADR, both legal documents, and a reviewed code change.

# ===========================================================================
# NOT here — different destinations by design (§22.2, §22.4, §22.6)
#
#   CI secrets          Cloudflare API token and zone ID, container-host
#                       deploy token, Android keystore (base64) and its
#                       passwords, Apple distribution certificate and
#                       provisioning profile, App Store Connect API key,
#                       Play service account JSON, Pub/Sub credentials
#   Secret manager      Production DATABASE_URL, service-role key, managed
#                       Redis URL
#   Password manager    Keystore master copy and offline backup
#   Native build input  google-services.json, APNs .p8, Cloudflare origin cert
#
# A deploy credential on a laptop is the thing §22.2 is written to prevent.
# ===========================================================================

# Do not place Supabase service-role keys, provider credentials, signing
# credentials, store secrets, or production connection strings in this file.
# Study assistant. Off unless AI_API_KEY and AI_BASE_URL are both set.
AI_API_KEY=
AI_BASE_URL=https://api.together.xyz
AI_MODEL=Qwen/Qwen3.5-9B
# Daily questions and monthly AI spend per plan live in the database
# (private.ai_plan_limits), not here. Prices must match the provider's list:
# the Plus / Max caps are enforced against them.
AI_PRICE_INPUT_USD_PER_MTOK=0.17
AI_PRICE_OUTPUT_USD_PER_MTOK=0.25
# Whiteboard notes, quizzes and flashcards. Off until the provider DPA and the
# minors' DPIA are in place (ADR-0029).
AI_LESSON_TOOLS_ENABLED=false

# JOIN-053 short class codes (e.g. K7QM-4XTR) - a second way to redeem a class
# join link, for a child typing on a parent's phone or a code on the board.
# Stored as an HMAC under this key, which must never be in the database and
# must differ from API_CURSOR_SIGNING_KEY and RATE_LIMIT_HMAC_SIGNING_KEY.
# Leave empty to issue links only. Generate with: openssl rand -hex 32
# CLASS_JOIN_CODE_KEY=
